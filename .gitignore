# implementations or SDKs are added to this repo rather than split
# into their own, uncomment the relevant blocks.

# Python
# __pycache__/
# *.py[cod]
# .venv/
# venv/
# .pytest_cache/
# *.egg-info/

# Node / TypeScript
# npm-debug.log*
# yarn-error.log
# *.tsbuildinfo

# Rust
# target/
# Cargo.lock

# C/C++
# *.o
# *.obj

